# Everything not explicitly needed to boot server/index.ts is excluded here
# -- keeps the build context small (data/artifacts/reference/.venv are all
# large, several GB combined) and mirrors .gitignore's "exclude dir
# contents, then re-include specific files" pattern (Docker can't
# re-include a file whose parent directory is itself fully excluded).
node_modules
.git
.venv
__pycache__
reference/
RAGINGOA-main/
web/
docs/
eval/
ingest/
bench/results
*.md

# only the deduped medium-scale corpus + its embeddings, nothing else
# under data/ (smoke/bakeoff scratch data, raw per-language files, the
# duplicate .npy copy of the embeddings already covered by .f32bin)
data/*
!data/medium
data/medium/*
!data/medium/passages_dedup.jsonl
!data/medium/embeddings.f32bin
!data/medium/embeddings_ids.json

# only the fp32 ONNX model + tokenizer (not the rejected int8 model, see
# CLAUDE.md's fp32-vs-int8 correction) + the calibrated thresholds
artifacts/*
!artifacts/onnx
artifacts/onnx/*
!artifacts/onnx/model.onnx
!artifacts/onnx/tokenizer.json
!artifacts/onnx/tokenizer_config.json
!artifacts/onnx/special_tokens_map.json
!artifacts/onnx/config.json
!artifacts/thresholds.json

# the cross-encoder reranker (server/ghana/rerank.ts, added after this file
# was first written -- bootFromDisk() ALWAYS passes artifacts/onnx_reranker,
# and rerank.boot()'s InferenceSession.create() throws rather than degrading
# if it's absent, so omitting these crashes the container on boot.
# int8 here, unlike the embedder: rerank.boot() is called with
# "model_int8.onnx" explicitly, and a cross-encoder logit tolerates
# quantization where the bi-encoder's 0.995 cosine gate did not.
!artifacts/onnx_reranker
artifacts/onnx_reranker/*
!artifacts/onnx_reranker/model_int8.onnx
!artifacts/onnx_reranker/tokenizer.json
!artifacts/onnx_reranker/tokenizer_config.json
!artifacts/onnx_reranker/special_tokens_map.json
!artifacts/onnx_reranker/config.json
