# artifacts (built or pulled, never committed — too large). `artifacts/*`,
# not `artifacts/`, is deliberate -- git can't re-include a file whose
# PARENT DIRECTORY is itself excluded, only its contents, so the whole-dir
# form would silently defeat the thresholds.json negation below.
artifacts/*
*.onnx
*.bin
*.npy
# ...except the calibrated guardrail thresholds (PLAN.md E5.5) -- tiny,
# and ARCHITECTURE.md §8.2 explicitly calls for committing it, unlike the
# multi-GB model/index artifacts around it.
!artifacts/thresholds.json

# secrets
.env
.env.*
!.env.example
*.pem
*.key
!server/**/*.key.ts

# node
node_modules/
bun.lockb
dist/
.turbo/

# python
.venv/
__pycache__/
*.pyc
data/

# eval outputs (regenerated, not source)
eval/results/*.csv
eval/results/*.png
!eval/results/ood_roc.png
bench/results/*.json

# stray empty dir that showed up locally, not part of the repo layout
docs/

# os/editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# WSL <-> Windows sync artifacts, if this dir is ever mirrored
*.swp

# locally-installed agent skills (dev tooling used to build this repo, not
# part of the shipped app — keep off the public repo)
.agents/
.claude/
skills-lock.json
